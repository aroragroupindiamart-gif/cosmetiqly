---
import { SITE_CONFIG } from '../lib/site_config.js';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, any>;
  noindex?: boolean;
}

const {
  title,
  description = "Cosmetiqly is an independent cosmetic ingredient safety database. Clinical INCI analysis scored and cited across 15 sensitive skin and safety standards.",
  canonicalPath,
  jsonLd,
  noindex = false
} = Astro.props;

// Drip gate enforcement: if middleware marked isDripped === false, page is strictly noindexed
const isDripped = Astro.locals?.isDripped !== false;
const shouldNoindex = noindex || !isDripped;

// Read site domain dynamically from env var or SITE_CONFIG (Hard Rule §0: NEVER hardcode domain)
const SITE_DOMAIN = import.meta.env.SITE_DOMAIN || SITE_CONFIG.siteDomain;
const currentPath = Astro.url.pathname;

let cleanCanonical: string;
if (canonicalPath) {
  cleanCanonical = `${SITE_DOMAIN}${canonicalPath.startsWith('/') ? '' : '/'}${canonicalPath}`;
} else if (currentPath === '/' || currentPath === '') {
  cleanCanonical = `${SITE_DOMAIN}/`;
} else {
  cleanCanonical = `${SITE_DOMAIN}${currentPath.replace(/\/+$/, '')}`;
}

const globalOrgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_DOMAIN}/#organization`,
      "name": "Cosmetiqly",
      "url": `${SITE_DOMAIN}/`,
      "logo": `${SITE_DOMAIN}/favicon.svg`,
      "knowsAbout": ["INCI Ingredients", "Cosmetic Safety", "Dermatology", "Comedogenicity", "Formulation Analysis"]
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_DOMAIN}/#website`,
      "url": `${SITE_DOMAIN}/`,
      "name": "Cosmetiqly",
      "publisher": { "@id": `${SITE_DOMAIN}/#organization` }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-white text-slate-800 antialiased selection:bg-emerald-100 selection:text-emerald-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="google-site-verification" content="hsYC4nUYa1HaDc6zfdgTXtEba48b3pW2bUJt9ljIQlM" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Cosmetiqly</title>
    <meta name="description" content={description} />

    {shouldNoindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={cleanCanonical} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Cosmetiqly`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cosmetiqly" />

    <!-- Google Fonts: Newsreader (Editorial Serif) & Inter (UI/Body Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(globalOrgSchema)} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="flex flex-col min-h-screen bg-white font-sans text-slate-700 antialiased">
    <!-- Editorial Masthead Header -->
    <header class="border-b border-slate-200 bg-white/95 backdrop-blur-sm sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 group">
          <span class="font-serif text-2xl font-semibold tracking-tight text-slate-900 group-hover:text-emerald-800 transition-colors">
            Cosmetiqly
          </span>
          <span class="text-[11px] font-sans font-medium px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200">
            Ingredient Safety
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/directory" class="hover:text-slate-900 transition-colors">Brand Directory</a>
          <a href="/rules" class="hover:text-slate-900 transition-colors">Safety Rules</a>
          <a href="/methodology" class="hover:text-slate-900 transition-colors">Methodology</a>
          <a href="/about" class="hover:text-slate-900 transition-colors">About</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="/#search" class="text-xs font-semibold px-3 py-1.5 rounded-md border border-slate-300 text-slate-700 hover:border-emerald-700 hover:text-emerald-800 transition-colors">
            Search INCI
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Editorial Footer with E-E-A-T Links & Disclaimer -->
    <footer class="border-t border-slate-200 bg-[#fbfbf9] mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <div class="md:col-span-2">
            <span class="font-serif text-xl font-semibold text-slate-900">Cosmetiqly</span>
            <p class="text-xs text-slate-500 mt-2 max-w-md leading-relaxed">
              Transparent, citation-backed INCI cosmetic safety reviews. We screen real formulation data against published toxicology, comedogenicity, and dermatological guidelines.
            </p>
            <p class="text-xs text-slate-400 mt-3">
              Data sourced under Open Database Licence (ODbL) from Open Beauty Facts.
            </p>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3">Database</h4>
            <ul class="space-y-2 text-xs text-slate-600">
              <li><a href="/directory" class="hover:text-emerald-800">Brand Directory A-Z</a></li>
              <li><a href="/rules" class="hover:text-emerald-800">15 Safety Rules</a></li>
              <li><a href="/methodology" class="hover:text-emerald-800">Scoring Methodology</a></li>
              <li><a href="/contact" class="hover:text-emerald-800">Report Wrong Formulation</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3">Editorial & Legal</h4>
            <ul class="space-y-2 text-xs text-slate-600">
              <li><a href="/about" class="hover:text-emerald-800">About & Reviewer Standards</a></li>
              <li><a href="/privacy" class="hover:text-emerald-800">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-emerald-800">Terms of Service</a></li>
              <li><a href="/contact" class="hover:text-emerald-800">Editorial Contact</a></li>
            </ul>
          </div>
        </div>

        <!-- Prominent Medical Disclaimer (§5) -->
        <div class="pt-8 border-t border-slate-200 text-xs text-slate-500 leading-relaxed">
          <p class="mb-2">
            <strong>Medical Disclaimer:</strong> Cosmetiqly provides educational ingredient analysis based on published scientific literature (CIR, SCCS, clinical dermatology studies). It does not constitute medical, diagnostic, or dermatological advice. Individual skin tolerances and allergic thresholds vary; patch-testing is advised prior to adopting new cosmetic formulations.
          </p>
          <p class="text-slate-400">
            &copy; {new Date().getFullYear()} Cosmetiqly. Editorial review supervised by {SITE_CONFIG.reviewerName}, {SITE_CONFIG.reviewerTitle}.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
