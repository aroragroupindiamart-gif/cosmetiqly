---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Editorial Contact &amp; Corrections — Cosmetiqly"
  description="Contact the Cosmetiqly editorial team. Submit an INCI ingredient formulation correction or report a data discrepancy with 72-hour turnaround."
  canonicalPath="/contact"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">Contact</span>
    </nav>

    <header class="mb-10 pb-6 border-b border-slate-200">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">
        Editorial Office
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl text-slate-900 font-semibold tracking-tight">
        Contact &amp; Formulation Corrections
      </h1>
      <p class="text-sm text-slate-600 mt-2">
        Have a question about a citation, or found a product that was recently reformulated?
      </p>
    </header>

    <div class="space-y-6 text-sm text-slate-700">
      <div class="p-6 rounded-lg border border-slate-200 bg-[#fbfbf9]">
        <h2 class="font-serif text-lg font-semibold text-slate-900 mb-2">
          Report an Inaccurate INCI List
        </h2>
        <p class="text-xs text-slate-600 leading-relaxed mb-3">
          To maintain data integrity, we review packaging submissions for formulation updates. Please include:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-xs text-slate-600 mb-4">
          <li>Product brand, exact product name, and barcode (EAN/UPC).</li>
          <li>A clear photograph or official brand link showing the current ingredient panel.</li>
          <li>Details on which ingredients have changed.</li>
        </ul>
        <div class="p-3 bg-white rounded border border-slate-200 text-xs font-mono text-slate-800">
          corrections@cosmetiqlyy.com
        </div>
        <p class="text-[11px] text-slate-500 mt-2">
          Correction SLA: Verified packaging updates are reviewed and processed within 72 business hours.
        </p>
      </div>

      <div class="p-6 rounded-lg border border-slate-200 bg-white">
        <h2 class="font-serif text-lg font-semibold text-slate-900 mb-2">
          Scientific Citations &amp; Inquiries
        </h2>
        <p class="text-xs text-slate-600 leading-relaxed mb-3">
          For clinical researchers, toxicologists, and data partners with questions regarding our Rule Engine v2 blacklists or study citations:
        </p>
        <div class="p-3 bg-[#fbfbf9] rounded border border-slate-200 text-xs font-mono text-slate-800">
          editorial@cosmetiqlyy.com
        </div>
      </div>
    </div>
  </div>
</Layout>
