---
import Layout from '../layouts/Layout.astro';
import { SAFETY_RULES } from '../lib/safety_rules_v2.js';
---

<Layout
  title="Safety Rules Index — Cosmetiqly"
  description="Explore the 15 dermatological and toxicological safety rules evaluated by Cosmetiqly, complete with clinical citations."
  canonicalPath="/rules"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">Safety Rules</span>
    </nav>

    <header class="mb-10">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">
        Evaluation Framework
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl text-slate-900 font-semibold tracking-tight">
        15 Dermatological Safety Standards
      </h1>
      <p class="text-sm text-slate-600 mt-2 leading-relaxed">
        Every rule in our engine is backed by scientific citations from the Cosmetic Ingredient Review (CIR), the EU Scientific Committee on Consumer Safety (SCCS), and clinical research.
      </p>
    </header>

    <div class="space-y-6">
      {SAFETY_RULES.map((rule, idx) => (
        <article class="p-6 rounded-lg border border-slate-200 bg-white">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-slate-400">RULE {String(idx + 1).padStart(2, '0')}</span>
            <span class={`text-[11px] font-bold px-2 py-0.5 rounded border uppercase ${
              rule.type === 'free' ? 'bg-slate-100 text-slate-700 border-slate-200' : 'bg-amber-50 text-amber-800 border-amber-200'
            }`}>
              {rule.type} standard
            </span>
          </div>

          <h2 class="font-serif text-xl font-semibold text-slate-900 mb-2">
            {rule.name}
          </h2>
          <p class="text-xs text-slate-600 mb-4 leading-relaxed">
            {rule.description}
          </p>

          <div class="border-t border-slate-100 pt-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
              Cited Blacklist Sample ({rule.triggers.length} Triggers)
            </h3>
            <div class="space-y-2">
              {rule.triggers.slice(0, 4).map(t => (
                <div class="text-xs p-2 rounded bg-[#fbfbf9] border border-slate-100">
                  <div class="flex items-center justify-between font-mono font-semibold text-slate-800 text-[11px]">
                    <span>{t.name}</span>
                    <span class={t.severity === 'HIGH' ? 'text-rose-700' : 'text-amber-700'}>{t.severity}</span>
                  </div>
                  <p class="text-[11px] text-slate-500 mt-0.5">{t.note} &mdash; <em>{t.citation}</em></p>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
