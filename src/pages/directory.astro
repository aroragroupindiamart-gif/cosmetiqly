---
import Layout from '../layouts/Layout.astro';
import { getTopBrands, getPopularChecks } from '../lib/db.js';

const runtimeEnv = Astro.locals?.runtime?.env;
const topBrands = await getTopBrands(48, runtimeEnv);
const popularChecks = await getPopularChecks(24, runtimeEnv);

function slugify(text: string) {
  return text.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<Layout title="Brand Directory A-Z - Skincare & Beauty Formulations" description="Browse all 67,000+ cosmetic, makeup, and skincare products analyzed for INCI ingredient safety across 15+ sensitive skin rules.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
      <a href="/" class="hover:text-rose-400">Home</a>
      <span>/</span>
      <span class="text-rose-400 font-semibold">Brand Directory A-Z</span>
    </nav>

    <!-- Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-semibold text-rose-400 mb-3">
        <span>✨</span> 67,000+ Formulations Directory
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-outfit text-white tracking-tight">
        Beauty & Skincare <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-purple-400">Brand Directory</span>
      </h1>
      <p class="text-slate-400 text-sm sm:text-base mt-3">
        Explore our complete INCI safety review database. Click any brand to browse evaluated formulations and safety check results.
      </p>
    </div>

    <!-- A-Z Alphabet Filter -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 p-4 rounded-2xl bg-slate-900/80 border border-slate-800 mb-12 shadow-xl">
      {alphabet.map((letter) => (
        <a
          href={`#brand-${letter}`}
          class="w-8 h-8 rounded-lg bg-slate-950 border border-slate-800 hover:border-rose-500 hover:text-rose-400 flex items-center justify-center text-xs font-bold text-slate-300 transition-all"
        >
          {letter}
        </a>
      ))}
    </div>

    <!-- Top Brands Grid -->
    <div class="mb-16">
      <h2 class="text-xl font-bold font-outfit text-white mb-6 flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-rose-500"></span>
        Top Skincare & Beauty Brands ({topBrands.length} Brands)
      </h2>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {topBrands.map((b: any) => (
          <a
            href={`/check/is-${slugify(b.brand)}-hydrating-cleanser-fungal-acne-safe`}
            class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-rose-500/50 hover:bg-slate-900 transition-all text-center group"
          >
            <div class="font-bold text-sm text-white group-hover:text-rose-400 transition-colors line-clamp-1">{b.brand}</div>
            <div class="text-[11px] text-slate-400 mt-1 font-mono">{b.product_count} Formulations</div>
          </a>
        ))}
      </div>
    </div>

    <!-- Popular Formulations Grid -->
    <div class="mb-16">
      <h2 class="text-xl font-bold font-outfit text-white mb-6 flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-purple-500"></span>
        Popular INCI Safety Checks ({popularChecks.length} Formulations)
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {popularChecks.map((item: any) => (
          <a
            href={`/check/${item.slug}`}
            class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-purple-500/50 transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-xs font-semibold text-rose-400">{item.brand}</span>
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded ${
                  item.status === 'PASS' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'
                }`}>
                  {item.status === 'PASS' ? 'SAFE' : 'NOT SAFE'}
                </span>
              </div>
              <h3 class="font-bold text-xs text-white group-hover:text-purple-300 transition-colors line-clamp-2">{item.product_name}</h3>
            </div>
            <div class="mt-3 pt-2 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
              <span>{item.rule_name}</span>
              <span class="text-rose-400 font-semibold">{item.safety_score}%</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- XML & HTML Sitemap Index Links for Crawlers -->
    <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800 text-center">
      <h3 class="text-sm font-bold text-slate-200 mb-2">Search Engine Indexing Resources</h3>
      <p class="text-xs text-slate-400 max-w-xl mx-auto mb-4">
        Our 1,005,000 programmatic safety checks are indexed via XML sitemap indexes and structured breadcrumb graphs.
      </p>
      <div class="flex items-center justify-center gap-4 text-xs font-semibold">
        <a href="/sitemap.xml" target="_blank" class="px-4 py-2 rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 transition-all">
          View Master Sitemap XML &rarr;
        </a>
        <a href="/robots.txt" target="_blank" class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 hover:bg-slate-700 transition-all">
          View Robots.txt &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>
