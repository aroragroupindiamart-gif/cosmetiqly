---
import Layout from '../layouts/Layout.astro';
import { getTopBrands, searchProducts, getTotalProductCount } from '../lib/db_v2.js';
import { getCurrentDripDay, isUrlDripped, getFirstRelevantCheckUrl } from '../lib/drip.js';

const db = Astro.locals?.runtime?.env?.DB;
const currentDay = getCurrentDripDay(Astro.locals?.runtime?.env);
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const url = new URL(Astro.request.url);
const query = url.searchParams.get('q') || '';

let searchResults: any[] = [];
if (query.trim().length >= 2) {
  const rawResults = await searchProducts(query.trim(), 24, db);
  searchResults = rawResults.map((p: any) => ({
    ...p,
    checkUrl: getFirstRelevantCheckUrl(p, currentDay)
  }));
}

const totalProducts = await getTotalProductCount(db);
const allTopBrands = await getTopBrands(100, db);
const topBrands = allTopBrands.filter((b: any) => isUrlDripped(`/brand/${b.brand_slug}`, currentDay)).slice(0, 72);
---

<Layout
  title={query ? `Search: "${query}" — Formulations Directory` : "Brand Directory A-Z — Cosmetiqly"}
  description={`Explore ${totalProducts} verified beauty, skincare, and cosmetic formulations. Search products or browse brands by letter.`}
  canonicalPath="/directory"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">Brand Directory</span>
    </nav>

    <header class="mb-10 text-center max-w-2xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">
        Verified Catalog
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl text-slate-900 font-semibold tracking-tight">
        Formulations & Brand Directory
      </h1>
      <p class="text-sm text-slate-600 mt-2">
        Browse real cosmetic and skincare formulations verified from Open Beauty Facts.
      </p>

      <!-- Search Input on Directory Page -->
      <form action="/directory" method="GET" class="mt-6 flex max-w-md mx-auto">
        <input
          type="text"
          name="q"
          value={query}
          placeholder="Search brand or product name..."
          class="flex-1 bg-white border border-slate-300 rounded-l-md px-3.5 py-2 text-sm text-slate-900 focus:outline-none focus:border-emerald-700"
        />
        <button type="submit" class="bg-emerald-800 text-white text-xs font-semibold px-4 rounded-r-md hover:bg-emerald-900 transition-colors">
          Search
        </button>
      </form>
    </header>

    {query && (
      <section class="mb-12">
        <h2 class="font-serif text-xl font-semibold text-slate-900 mb-4">
          Search Results for &ldquo;{query}&rdquo; ({searchResults.length})
        </h2>
        {searchResults.length === 0 ? (
          <p class="text-xs text-slate-500">No verified products matched your search term.</p>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {searchResults.map(p => (
              p.checkUrl ? (
                <a
                  href={p.checkUrl}
                  class="p-3.5 rounded-lg border border-slate-200 hover:border-emerald-700 bg-white transition-colors block text-xs"
                >
                  <span class="font-semibold text-slate-900 block truncate">{p.brand}</span>
                  <span class="text-slate-700 block truncate font-medium mt-0.5">{p.name}</span>
                  <span class="text-[11px] text-slate-500 block mt-1">{p.ingredient_count} INCI ingredients &middot; {p.category}</span>
                </a>
              ) : (
                <div class="p-3.5 rounded-lg border border-slate-200 bg-white block text-xs">
                  <span class="font-semibold text-slate-900 block truncate">{p.brand}</span>
                  <span class="text-slate-700 block truncate font-medium mt-0.5">{p.name}</span>
                  <span class="text-[11px] text-slate-500 block mt-1">{p.ingredient_count} INCI ingredients &middot; {p.category}</span>
                </div>
              )
            ))}
          </div>
        )}
      </section>
    )}

    <!-- A-Z Navigation Bar -->
    <section class="mb-12">
      <div class="flex flex-wrap items-center justify-center gap-1.5 p-3 rounded-lg border border-slate-200 bg-[#fbfbf9]">
        {alphabet.map(letter => (
          <a
            href={`/brands/${letter.toLowerCase()}`}
            class="w-7 h-7 flex items-center justify-center rounded text-xs font-medium text-slate-700 hover:bg-emerald-800 hover:text-white transition-colors"
          >
            {letter}
          </a>
        ))}
      </div>
    </section>

    <!-- Top Brands Grid -->
    <section>
      <h2 class="font-serif text-xl font-semibold text-slate-900 mb-4">
        Top Formulations by Brand
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {topBrands.map((b: any) => (
          <a
            href={`/brand/${b.brand_slug}`}
            class="p-3 rounded-lg border border-slate-200 hover:border-slate-400 bg-white block text-center transition-colors"
          >
            <span class="text-xs font-semibold text-slate-900 block truncate">{b.brand}</span>
            <span class="text-[11px] text-slate-500">{b.product_count} products</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
