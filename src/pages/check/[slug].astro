---
import Layout from '../../layouts/Layout.astro';
import { getPageData, getRelatedChecks, getSafeAlternative } from '../../lib/db.js';
import { synthesizeBreakdown, generateFAQ } from '../../lib/template_synthesizer.js';

const { slug } = Astro.params;

// Fetch page data from SQLite / Cloudflare D1
const runtimeEnv = Astro.locals?.runtime?.env;
const pageData = await getPageData(slug, runtimeEnv);

if (!pageData) {
  return Astro.redirect('/404');
}

const {
  brand,
  product_name,
  category,
  ingredients_raw,
  ingredients_list,
  rule_name,
  rule_slug,
  rule_description,
  status,
  conflict_list,
  safety_score,
  product_id,
  rule_id
} = pageData;

const parsedConflicts = JSON.parse(conflict_list || '[]');
const parsedIngredients = JSON.parse(ingredients_list || '[]');
const isPass = status === 'PASS';

// Synthesize high-uniqueness programmatic content paragraph & FAQs
const breakdown = synthesizeBreakdown({
  brand,
  productName: product_name,
  category: category || 'Cosmetic Formulation',
  ruleName: rule_name,
  ruleSlug: rule_slug,
  status,
  conflicts: parsedConflicts,
  totalIngredients: parsedIngredients.length,
  safetyScore: safety_score
});

const faqs = generateFAQ({
  brand,
  productName: product_name,
  ruleName: rule_name,
  status,
  conflicts: parsedConflicts,
  safetyScore: safety_score
});

// Fetch internal link related checks for same product
const relatedChecks = await getRelatedChecks(product_id, rule_id, runtimeEnv);

// Fetch safe alternative recommendation if product is NOT SAFE (FAIL)
const safeAlternative = !isPass ? await getSafeAlternative(rule_id, category, product_id, runtimeEnv) : null;

const currentUrl = Astro.url.href;

// Google-compliant JSON-LD Structured Data with @graph for Product, FAQPage & BreadcrumbList
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `${currentUrl}#product`,
      "name": `${brand} ${product_name}`,
      "brand": { "@type": "Brand", "name": brand },
      "category": category,
      "description": breakdown.openingParagraph,
      "review": {
        "@type": "Review",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": safety_score,
          "bestRating": 100,
          "worstRating": 0
        },
        "author": { "@type": "Organization", "name": "Cosmetiqly Safety Engine" }
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${currentUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.url.origin },
        { "@type": "ListItem", "position": 2, "name": brand, "item": `${Astro.url.origin}/#search` },
        { "@type": "ListItem", "position": 3, "name": product_name, "item": currentUrl }
      ]
    }
  ]
};

const pageTitle = `Is ${brand} ${product_name} ${rule_name} Safe? INCI Analysis`;
const metaDesc = `Full INCI ingredient review for ${brand} ${product_name}. ${breakdown.verdictSummary}. ${parsedIngredients.length} ingredients evaluated.`;

// Amazon & Sephora Affiliate URL Generator
const affiliateSearchQuery = safeAlternative ? encodeURIComponent(`${safeAlternative.brand} ${safeAlternative.product_name}`) : '';
const amazonAffiliateUrl = `https://www.amazon.com/s?k=${affiliateSearchQuery}&tag=cosmetiqly20-20`;
const sephoraAffiliateUrl = `https://www.sephora.com/search?keyword=${affiliateSearchQuery}&ref=cosmetiqly`;
---

<Layout title={pageTitle} description={metaDesc} jsonLd={jsonLd}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-rose-400">Home</a>
      <span>/</span>
      <span class="text-slate-300">{brand}</span>
      <span>/</span>
      <span class="text-slate-300">{product_name}</span>
      <span>/</span>
      <span class="text-rose-400 font-semibold">{rule_name}</span>
    </nav>

    <!-- Dynamic H1 Heading -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-semibold text-rose-400 mb-3">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        INCI Medical Safety Check
      </div>
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold font-outfit text-white tracking-tight leading-tight">
        Is <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-pink-400 to-purple-400">{brand} {product_name}</span> {rule_name} Safe?
      </h1>
      <p class="text-slate-400 mt-2 text-sm sm:text-base">Comprehensive ingredient safety verdict & trigger breakdown across {parsedIngredients.length} INCI components.</p>
    </div>

    <!-- Visual Safety Badge Hero Banner -->
    <div class={`relative overflow-hidden rounded-2xl p-6 md:p-8 border shadow-2xl mb-10 transition-all ${
      isPass
        ? 'bg-gradient-to-br from-emerald-950/80 via-slate-900 to-slate-950 border-emerald-500/40 shadow-emerald-950/40'
        : 'bg-gradient-to-br from-rose-950/80 via-slate-900 to-slate-950 border-rose-500/40 shadow-rose-950/40'
    }`}>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
        <div class="flex items-start gap-4">
          <div class={`w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center text-3xl sm:text-4xl shadow-xl shrink-0 ${
            isPass ? 'bg-emerald-500 text-white shadow-emerald-500/30' : 'bg-rose-500 text-white shadow-rose-500/30'
          }`}>
            {isPass ? '✓' : '✕'}
          </div>
          <div>
            <div class="flex items-center gap-3">
              <span class={`px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider ${
                isPass ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-400 border border-rose-500/30'
              }`}>
                VERDICT: {status === 'PASS' ? 'SAFE FOR USE' : 'NOT SAFE'}
              </span>
              <span class="text-xs text-slate-400">{category || 'Skincare Product'}</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold font-outfit text-white mt-2">
              {breakdown.verdictSummary}
            </h2>
            <p class="text-slate-300 text-xs sm:text-sm mt-1 max-w-2xl">{rule_description}</p>
          </div>
        </div>

        <!-- Safety Score Gauge Component -->
        <div class="flex flex-col items-center md:items-end justify-center shrink-0 bg-slate-900/80 p-4 rounded-xl border border-slate-800">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Cosmetiqly Safety Score</span>
          <div class="flex items-baseline gap-1">
            <span class={`text-4xl font-extrabold font-outfit ${isPass ? 'text-emerald-400' : 'text-rose-400'}`}>{safety_score}</span>
            <span class="text-lg font-bold text-slate-500">%</span>
          </div>

          <div class="w-36 h-2.5 bg-slate-800 rounded-full overflow-hidden mt-2 border border-slate-700">
            <div class={`h-full rounded-full transition-all duration-500 ${
              isPass ? 'bg-gradient-to-r from-emerald-500 to-teal-400' : 'bg-gradient-to-r from-rose-600 to-red-400'
            }`} style={`width: ${safety_score}%`}></div>
          </div>
        </div>
      </div>
    </div>

    <!-- AFFILIATE BONUS WIDGET: Safe Alternative Recommendation (Appears when status is FAIL) -->
    {!isPass && safeAlternative && (
      <div class="relative overflow-hidden rounded-2xl p-6 md:p-8 bg-gradient-to-r from-emerald-950/90 via-slate-900 to-slate-950 border-2 border-emerald-500/50 shadow-2xl mb-10">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-2">
              🌟 Verified 100% {rule_name} Safe Alternative
            </div>
            <h3 class="text-xl font-bold font-outfit text-white">
              Looking for a {rule_name} Safe Alternative?
            </h3>
            <p class="text-slate-300 text-xs sm:text-sm mt-1">
              Swap <strong class="text-rose-400">{brand} {product_name}</strong> with <strong class="text-emerald-400">{safeAlternative.brand} {safeAlternative.product_name}</strong>. Zero blacklisted triggers for {rule_name.toLowerCase()}.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a
              href={`/check/${safeAlternative.slug}`}
              class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs border border-slate-700 transition-colors"
            >
              Read INCI Review &rarr;
            </a>
            <a
              href={amazonAffiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-extrabold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-1.5"
            >
              <span>🛒</span> Buy on Amazon
            </a>
            <a
              href={sephoraAffiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-extrabold text-xs shadow-lg shadow-pink-600/20 transition-all flex items-center gap-1.5"
            >
              <span>✨</span> Sephora
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Dynamic Breakdown Box -->
    <div class="bg-slate-900/80 rounded-2xl p-6 md:p-8 border border-slate-800 mb-10 shadow-lg">
      <h3 class="text-lg font-bold font-outfit text-white mb-3 flex items-center gap-2">
        <svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Clinical Breakdown & Synthesized Verdict
      </h3>
      <p class="text-slate-300 leading-relaxed text-sm sm:text-base mb-4">{breakdown.openingParagraph}</p>
      <p class="text-slate-400 text-xs sm:text-sm">{breakdown.scoreExplanation}</p>

      {!isPass && parsedConflicts.length > 0 && (
        <div class="mt-4 p-4 rounded-xl bg-rose-950/40 border border-rose-500/30">
          <span class="text-xs font-bold text-rose-400 uppercase tracking-wider block mb-2">Flagged Trigger Ingredients ({parsedConflicts.length})</span>
          <div class="flex flex-wrap gap-2">
            {parsedConflicts.map((c: string) => (
              <span class="px-3 py-1 rounded-lg bg-rose-500/20 text-rose-300 text-xs font-mono font-semibold border border-rose-500/40">
                ⚠️ {c}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Interactive INCI Ingredient Table -->
    <div class="bg-slate-900/80 rounded-2xl p-6 md:p-8 border border-slate-800 mb-10 shadow-lg">
      <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <h3 class="text-lg font-bold font-outfit text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          Full INCI Ingredient List ({parsedIngredients.length} Ingredients)
        </h3>
        <span class="text-xs text-slate-400">Parsed from official formula disclosure</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-slate-400 uppercase text-[11px] font-mono">
              <th class="py-3 px-4">#</th>
              <th class="py-3 px-4">INCI Ingredient Name</th>
              <th class="py-3 px-4 text-right">{rule_name} Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {parsedIngredients.map((ing: string, idx: number) => {
              const isTrigger = parsedConflicts.some((c: string) => ing.toLowerCase().includes(c.toLowerCase()));
              return (
                <tr class={`hover:bg-slate-800/40 transition-colors ${isTrigger ? 'bg-rose-950/20' : ''}`}>
                  <td class="py-3 px-4 text-slate-500 font-mono">{idx + 1}</td>
                  <td class="py-3 px-4 font-medium text-slate-200 capitalize">
                    {ing}
                  </td>
                  <td class="py-3 px-4 text-right">
                    {isTrigger ? (
                      <span class="px-2.5 py-1 rounded-md bg-rose-500/20 text-rose-400 font-semibold border border-rose-500/30 text-xs">
                        ⚠️ FLAGGED TRIGGER
                      </span>
                    ) : (
                      <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 font-semibold border border-emerald-500/20 text-xs">
                        ✓ CLEAN / SAFE
                      </span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Related Product Safety Checks -->
    {relatedChecks.length > 0 && (
      <div class="bg-slate-900/60 rounded-2xl p-6 md:p-8 border border-slate-800 mb-10">
        <h3 class="text-lg font-bold font-outfit text-white mb-4">
          Other Safety Checks for {brand} {product_name}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedChecks.map((rel: any) => (
            <a href={`/check/${rel.slug}`} class="group p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-rose-500/50 hover:shadow-lg hover:shadow-rose-950/20 transition-all">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-slate-300 group-hover:text-rose-400 transition-colors">{rel.rule_name}</span>
                <span class={`text-[11px] font-bold px-2 py-0.5 rounded ${
                  rel.status === 'PASS' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'
                }`}>
                  {rel.status === 'PASS' ? 'SAFE' : 'FAIL'}
                </span>
              </div>
              <p class="text-xs text-slate-400 line-clamp-1">{brand} {product_name}</p>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Frequently Asked Questions (FAQ Section for SEO) -->
    <div class="bg-slate-900/60 rounded-2xl p-6 md:p-8 border border-slate-800 mb-10">
      <h3 class="text-lg font-bold font-outfit text-white mb-4">
        Frequently Asked Questions
      </h3>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
            <h4 class="font-semibold text-sm text-slate-200 mb-1">{faq.question}</h4>
            <p class="text-xs text-slate-400 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
