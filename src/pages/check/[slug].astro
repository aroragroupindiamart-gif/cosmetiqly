---
import Layout from '../../layouts/Layout.astro';
import { getPageData, getRelatedChecks, getSafeAlternative, getBrandChecks } from '../../lib/db.js';
import { synthesizeBreakdown, generateFAQ } from '../../lib/template_synthesizer.js';

const { slug = '' } = Astro.params;
const runtimeEnv = Astro.locals?.runtime?.env;

const page = await getPageData(slug, runtimeEnv);

// True RFC 404 response (No 302/301 redirects)
if (!page) {
  Astro.response.status = 404;
}

const {
  product_id = '',
  brand = 'Cosmetic Formulation',
  product_name = 'Product Review',
  category = 'Skincare',
  ingredients_raw = '',
  rule_id = 'rule-fungal-acne',
  rule_name = 'Fungal Acne (Malassezia)',
  rule_slug = 'fungal-acne',
  status = 'PASS',
  conflict_list: conflictListRaw = '[]',
  safety_score = 100
} = page || {};

const isPass = status === 'PASS';
let conflictList: string[] = [];
try {
  conflictList = conflictListRaw ? JSON.parse(conflictListRaw) : [];
} catch (e) {
  conflictList = [];
}

let parsedIngredients: string[] = [];
try {
  parsedIngredients = JSON.parse(page?.ingredients_list || '[]');
} catch (e) {
  parsedIngredients = (ingredients_raw || '').split(',').map((s: string) => s.trim()).filter(Boolean);
}

// Internal link queries
const relatedChecks = page ? await getRelatedChecks(product_id, rule_id, runtimeEnv) : [];
const brandChecks = page ? await getBrandChecks(brand, product_id, runtimeEnv) : [];
const safeAlternative = (!isPass && page) ? await getSafeAlternative(rule_id, category, product_id, runtimeEnv) : null;

// Dynamic text & FAQs
const breakdown = page ? synthesizeBreakdown({
  brand,
  productName: product_name,
  category: category || 'Cosmetic Formulation',
  ruleName: rule_name,
  ruleSlug: rule_slug,
  status,
  conflicts: conflictList,
  totalIngredients: parsedIngredients.length,
  safetyScore: safety_score
}) : null;

const faqs = page ? generateFAQ({
  brand,
  productName: product_name,
  ruleName: rule_name,
  status,
  conflicts: conflictList,
  safetyScore: safety_score
}) : [];

const metaTitle = page ? `Is ${brand} ${product_name} ${rule_name} Safe? INCI Analysis` : 'Page Not Found - Cosmetic Safety Check';
const metaDescription = page
  ? `Full INCI ingredient review for ${brand} ${product_name}. ${isPass ? 'Zero flagged triggers' : `Contains ${conflictList.length} Flagged Trigger(s)`} for ${rule_name}.`
  : 'The requested ingredient safety review was not found.';
const canonicalUrl = `https://cosmetiqly.com/check/${slug}`;
---

<Layout title={metaTitle} description={metaDescription} canonicalUrl={canonicalUrl}>
  {!page ? (
    <div class="max-w-4xl mx-auto px-4 py-20 text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-2xl font-bold mb-6">
        404
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-outfit text-white mb-4">
        Formulation Check Not Found
      </h1>
      <p class="text-slate-400 max-w-md mx-auto text-sm mb-8">
        The requested ingredient safety review does not exist in our database or the URL slug is invalid.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href="/" class="px-5 py-2.5 rounded-xl bg-rose-500 text-white text-xs font-semibold hover:bg-rose-600 transition-colors">
          Return to Homepage
        </a>
        <a href="/directory" class="px-5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 text-xs font-semibold hover:border-slate-700 transition-colors">
          Browse Brand Directory
        </a>
      </div>
    </div>
  ) : (
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <!-- Breadcrumbs Link Silo -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-rose-400 transition-colors">Home</a>
        <span>/</span>
        <a href={`/brand/${brand.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="hover:text-rose-400 transition-colors">{brand}</a>
        <span>/</span>
        <span class="text-slate-300">{product_name}</span>
        <span>/</span>
        <span class="text-rose-400 font-semibold">{rule_name}</span>
      </nav>

      <!-- Dynamic H1 Heading -->
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-semibold text-rose-400 mb-3">
          <span class={`w-2 h-2 rounded-full ${isPass ? 'bg-emerald-500' : 'bg-rose-500'} animate-pulse`}></span>
          INCI Medical Safety Check
        </div>
        <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold font-outfit text-white tracking-tight leading-tight">
          Is <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-pink-400 to-purple-400">{brand} {product_name}</span> {rule_name} Safe?
        </h1>
        <p class="text-slate-400 mt-2 text-sm sm:text-base">Comprehensive ingredient safety verdict & trigger breakdown across {parsedIngredients.length} INCI components.</p>
      </div>

      <!-- Visual Safety Badge Hero Banner -->
      <div class={`relative overflow-hidden rounded-2xl p-6 md:p-8 border shadow-2xl mb-10 transition-all ${
        isPass
          ? 'bg-gradient-to-br from-emerald-950/80 via-slate-900 to-slate-950 border-emerald-500/40 shadow-emerald-950/40'
          : 'bg-gradient-to-br from-rose-950/80 via-slate-900 to-slate-950 border-rose-500/40 shadow-rose-950/40'
      }`}>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
          <div class="flex items-start gap-4">
            <div class={`w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center text-3xl sm:text-4xl shadow-xl shrink-0 ${
              isPass ? 'bg-emerald-500 text-white shadow-emerald-500/30' : 'bg-rose-500 text-white shadow-rose-500/30'
            }`}>
              {isPass ? '✓' : '✕'}
            </div>
            <div>
              <div class="flex items-center gap-3">
                <span class={`px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider ${
                  isPass ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-400 border border-rose-500/30'
                }`}>
                  {isPass ? 'VERIFIED SAFE' : 'NOT RECOMMENDED'}
                </span>
                <span class="text-xs text-slate-400 font-medium">Rule: {rule_name}</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold font-outfit text-white mt-1">
                {isPass ? `Safe for ${rule_name}` : `Fails ${rule_name} Safety Standards`}
              </h2>
              <p class="text-slate-300 text-sm mt-1 max-w-xl leading-relaxed">
                {breakdown?.openingParagraph}
              </p>
            </div>
          </div>

          <div class="flex md:flex-col items-center justify-between md:justify-center p-4 rounded-xl bg-slate-900/80 border border-slate-800 shrink-0 min-w-[140px] text-center">
            <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Safety Score</div>
            <div class={`text-3xl sm:text-4xl font-extrabold font-outfit ${isPass ? 'text-emerald-400' : 'text-rose-400'}`}>
              {safety_score}%
            </div>
            <div class="text-[11px] text-slate-500">{isPass ? 'Clean Formulation' : `${conflictList.length} Triggers Detected`}</div>
          </div>
        </div>
      </div>

      <!-- Flagged Ingredients Warning (If Failed) -->
      {!isPass && conflictList.length > 0 && (
        <div class="mb-10 p-6 rounded-2xl bg-rose-950/40 border border-rose-500/30">
          <h3 class="text-lg font-bold font-outfit text-rose-300 mb-2 flex items-center gap-2">
            <span>⚠️</span> Flagged Ingredient Triggers ({conflictList.length})
          </h3>
          <p class="text-xs text-slate-300 mb-4">
            The following ingredients in this formulation violate strict dermatological standards for {rule_name}:
          </p>
          <div class="flex flex-wrap gap-2">
            {conflictList.map((item) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-500/20 border border-rose-500/40 text-rose-200 text-xs font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                {item}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Safe Alternative Recommendation Widget -->
      {safeAlternative && (
        <div class="mb-10 p-6 rounded-2xl bg-gradient-to-r from-emerald-950/40 via-slate-900 to-slate-900 border border-emerald-500/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              Recommended Safe Alternative
            </span>
            <h4 class="text-base font-bold text-white mt-1">
              Looking for a {rule_name}-safe {safeAlternative.category || 'product'}?
            </h4>
            <p class="text-xs text-slate-400 mt-0.5">
              Switch to <strong class="text-slate-200">{safeAlternative.brand} {safeAlternative.product_name}</strong> ({safeAlternative.safety_score}% Safety Score).
            </p>
          </div>
          <a
            href={`/check/${safeAlternative.slug}`}
            class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs shrink-0 transition-colors shadow-lg shadow-emerald-500/20 text-center"
          >
            View Safe Alternative &rarr;
          </a>
        </div>
      )}

      <!-- Complete INCI Ingredient Breakdown -->
      <div class="mb-12 p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold font-outfit text-white flex items-center gap-2">
            <span>🧪</span> Full INCI Ingredients List ({parsedIngredients.length})
          </h3>
        </div>
        <p class="text-xs text-slate-400 mb-6">
          Every ingredient analyzed by Cosmetiqly against international cosmetic safety datasets.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
          {parsedIngredients.map((ingredient) => {
            const isTrigger = conflictList.some(c => c.toLowerCase() === ingredient.toLowerCase());
            return (
              <div class={`p-3 rounded-xl border text-xs flex items-center justify-between transition-colors ${
                isTrigger
                  ? 'bg-rose-950/30 border-rose-500/40 text-rose-300 font-semibold'
                  : 'bg-slate-950/60 border-slate-800/80 text-slate-300'
              }`}>
                <span class="truncate mr-2">{ingredient}</span>
                {isTrigger ? (
                  <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-400 border border-rose-500/30 shrink-0">
                    FLAGGED
                  </span>
                ) : (
                  <span class="text-[10px] text-slate-500 font-mono shrink-0">SAFE</span>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <!-- Product Silo (Other Checks for This Same Product) -->
      {relatedChecks.length > 0 && (
        <div class="mb-12">
          <h3 class="text-lg font-bold font-outfit text-white mb-4 flex items-center gap-2">
            <span>🔍</span> Other Safety Checks for {product_name}
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
            {relatedChecks.map((rc: any) => (
              <a
                href={`/check/${rc.slug}`}
                class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-rose-500/50 hover:bg-slate-900 transition-all flex flex-col justify-between group text-center"
              >
                <div class="text-xs font-semibold text-white group-hover:text-rose-400 transition-colors line-clamp-1">{rc.rule_name}</div>
                <div class={`text-[11px] font-bold mt-2 px-2 py-0.5 rounded-full ${
                  rc.status === 'PASS' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-rose-500/10 text-rose-400'
                }`}>
                  {rc.status === 'PASS' ? 'SAFE' : 'NOT SAFE'}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Brand Silo (Other Products by This Brand) -->
      {brandChecks.length > 0 && (
        <div class="mb-12">
          <h3 class="text-lg font-bold font-outfit text-white mb-4 flex items-center gap-2">
            <span>🏷️</span> More Formulations by {brand}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
            {brandChecks.map((bc: any) => (
              <a
                href={`/check/${bc.slug}`}
                class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-purple-500/50 transition-all group flex flex-col justify-between"
              >
                <div class="text-xs font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-2">{bc.product_name}</div>
                <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800">
                  <span>{bc.rule_name}</span>
                  <span class={bc.status === 'PASS' ? 'text-emerald-400 font-bold' : 'text-rose-400 font-bold'}>{bc.status}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Frequently Asked Questions -->
      <div class="p-6 md:p-8 rounded-2xl bg-slate-900/50 border border-slate-800 mb-12">
        <h3 class="text-xl font-bold font-outfit text-white mb-6">Frequently Asked Questions</h3>
        <div class="space-y-6">
          {faqs.map((faq) => (
            <div class="border-b border-slate-800/80 pb-4 last:border-0 last:pb-0">
              <h4 class="font-bold text-sm text-slate-200 mb-1.5">{faq.question}</h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</Layout>
