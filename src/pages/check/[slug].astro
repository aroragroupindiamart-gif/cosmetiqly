---
import Layout from '../../layouts/Layout.astro';
import { getCheckPageData, getEvaluatedAlternatives, getOtherProductChecks } from '../../lib/db_v2.js';
import { SITE_CONFIG } from '../../lib/site_config.js';
import { getCurrentDripDay, isUrlDripped, buildCheckSlug, isValidObfImageUrl } from '../../lib/drip.js';

const db = Astro.locals?.runtime?.env?.DB;
const currentDay = getCurrentDripDay(Astro.locals?.runtime?.env);
const { slug = '' } = Astro.params;
const checkData = await getCheckPageData(slug, db);

if (!checkData) {
  Astro.response.status = 404;
}

const { product, rule, evaluation } = checkData || {};
const isFound = !!checkData;

const rawAlternatives = isFound ? await getEvaluatedAlternatives(product.barcode, rule, product.category, 3, db) : [];
const alternatives = rawAlternatives.map((alt: any) => {
  const altSlug = buildCheckSlug(alt.brand_slug, alt.product_slug, rule.slug);
  return {
    ...alt,
    altSlug,
    isDripped: isUrlDripped(`/check/${altSlug}`, currentDay)
  };
});

const otherChecks = isFound
  ? (await getOtherProductChecks(product, rule.slug)).map((oc: any) => ({
      ...oc,
      isDripped: isUrlDripped(`/check/${oc.slug}`, currentDay)
    }))
  : [];

const isBrandDripped = isFound ? isUrlDripped(`/brand/${product.brand_slug}`, currentDay) : false;
const validImageUrl = isFound && isValidObfImageUrl(product.image_url) ? product.image_url.trim() : undefined;

const metaTitle = isFound
  ? `Is ${product.brand} ${product.name} ${rule.name} Safe? INCI Review`
  : 'Safety Check Not Found — Cosmetiqly';

const metaDesc = isFound
  ? `INCI review of ${product.brand} ${product.name} for ${rule.name}. ${evaluation.displayString}. Cited against published dermatological research.`
  : 'The requested product formulation safety evaluation was not found.';

// Single source of truth for BOTH visible FAQ section (§3.3) and FAQPage JSON-LD
const faqItems = isFound ? [
  {
    question: `Is ${product.brand} ${product.name} ${rule.name} safe?`,
    answer: `${product.brand} ${product.name} received a verdict of "${evaluation.verdictText}" with a score of ${evaluation.score.toFixed(1)}/10. ${evaluation.displayString}.`
  },
  {
    question: `Which ingredients were flagged in ${product.name} for ${rule.name}?`,
    answer: evaluation.flaggedCount > 0
      ? `The following ingredients were flagged: ${evaluation.flagged.map((f: any) => `${f.ingredient} (${f.severity} concern: ${f.note})`).join('; ')}.`
      : `Zero ingredients were flagged for ${rule.name}.`
  }
] : [];

// Schema.org FAQPage & Product structured data
const productSchema: Record<string, any> = isFound ? {
  "@type": "Product",
  "name": `${product.brand} ${product.name}`,
  "brand": { "@type": "Brand", "name": product.brand },
  "category": product.category,
  "sku": product.barcode
} : {};
if (isFound && validImageUrl) {
  productSchema.image = validImageUrl;
}

const jsonLd = isFound ? {
  "@context": "https://schema.org",
  "@graph": [
    productSchema,
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }
  ]
} : undefined;
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonicalPath={isFound ? `/check/${slug}` : undefined}
  noindex={!isFound}
  jsonLd={jsonLd}
  ogImage={validImageUrl}
  ogImageAlt={isFound ? `${product.brand} ${product.name}` : undefined}
>
  {!isFound ? (
    <div class="max-w-3xl mx-auto px-4 py-20 text-center">
      <span class="text-xs font-mono font-bold px-2 py-1 bg-slate-100 text-slate-600 rounded border border-slate-200">
        404 NOT FOUND
      </span>
      <h1 class="font-serif text-3xl font-semibold text-slate-900 mt-4 mb-3">
        Formulation Check Not Found
      </h1>
      <p class="text-sm text-slate-600 max-w-md mx-auto mb-8">
        This check does not exist in our verified database or is not dermatologically relevant for this product category.
      </p>
      <a href="/directory" class="text-xs font-semibold px-4 py-2 bg-emerald-800 text-white rounded hover:bg-emerald-900 transition-colors">
        Browse Brand Directory
      </a>
    </div>
  ) : (
    <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
      <!-- 1. Breadcrumbs (§5) -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 flex-wrap">
        <a href="/" class="hover:text-slate-900">Home</a>
        <span>/</span>
        {isBrandDripped ? (
          <a href={`/brand/${product.brand_slug}`} class="hover:text-slate-900">{product.brand}</a>
        ) : (
          <span class="text-slate-600">{product.brand}</span>
        )}
        <span>/</span>
        <span class="text-slate-700 truncate max-w-[200px]">{product.name}</span>
        <span>/</span>
        <span class="text-emerald-800 font-medium">{rule.name}</span>
      </nav>

      <!-- 2. H1 Title -->
      <header class="mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">
          {product.brand} &middot; {product.category}
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl text-slate-900 font-semibold tracking-tight">
          Is {product.brand} {product.name} {rule.name} Safe?
        </h1>
      </header>

      <!-- 3. Score Tile + Plain Verdict -->
      <div class="p-6 rounded-lg border border-slate-200 bg-[#fbfbf9] mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class={`text-xs font-bold px-2.5 py-0.5 rounded border ${
                evaluation.score >= 9.5
                  ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                  : evaluation.score >= 7.0
                    ? 'bg-amber-50 text-amber-800 border-amber-200'
                    : 'bg-rose-50 text-rose-800 border-rose-200'
              }`}>
                {evaluation.tierLabel}
              </span>
              <span class="text-xs text-slate-500">Standard: {rule.name}</span>
            </div>
            <h2 class="font-serif text-2xl font-semibold text-slate-900">
              {evaluation.verdictText}
            </h2>
            <p class="text-xs text-slate-600 mt-1 font-mono">
              {evaluation.displayString}
            </p>
          </div>

          <div class="text-left sm:text-right border-t sm:border-t-0 sm:border-l border-slate-200 pt-3 sm:pt-0 sm:pl-6 shrink-0">
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500 block">Cosmetiqly Score</span>
            <span class="font-serif text-4xl font-semibold text-slate-900">
              {evaluation.score.toFixed(1)}<span class="text-base text-slate-400 font-normal">/10</span>
            </span>
          </div>
        </div>
      </div>

      <!-- 4. Cited Explanations for Each Flagged Ingredient (§5 requirement) -->
      {evaluation.flaggedCount > 0 ? (
        <section class="mb-10">
          <h3 class="font-serif text-xl font-semibold text-slate-900 mb-3">
            Flagged ingredients & clinical citations ({evaluation.flaggedCount})
          </h3>
          <p class="text-xs text-slate-600 mb-4">
            The following ingredients in this formulation conflict with {rule.name} standards:
          </p>

          <div class="space-y-3">
            {evaluation.flagged.map((f: any) => (
              <div class="p-4 rounded-lg border border-slate-200 bg-white">
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class="font-mono text-sm font-semibold text-slate-900">{f.ingredient}</span>
                  <span class={`text-[10px] font-bold px-2 py-0.5 rounded border uppercase ${
                    f.severity === 'HIGH' ? 'bg-rose-50 text-rose-800 border-rose-200' : 'bg-amber-50 text-amber-800 border-amber-200'
                  }`}>
                    {f.severity} Concern
                  </span>
                </div>
                <p class="text-xs text-slate-600 mb-2 leading-relaxed">{f.note}</p>
                <div class="text-[11px] text-slate-500 border-t border-slate-100 pt-1.5">
                  <strong>Citation:</strong> {f.citation}
                </div>
              </div>
            ))}
          </div>
        </section>
      ) : (
        <section class="mb-10 p-5 rounded-lg border border-emerald-200 bg-emerald-50/50">
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-emerald-100 border border-emerald-300 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-base font-semibold text-emerald-950 mb-1">
                Formulation Analysis: Why This Product Passes
              </h3>
              <p class="text-xs text-emerald-900 leading-relaxed mb-1">
                <strong>{product.brand} {product.name}:</strong> 0 of {rule.triggers.length} {rule.name} triggers matched across {evaluation.totalIngredients} INCI ingredients ({evaluation.score.toFixed(1)}/10 &mdash; {evaluation.verdictText}).
              </p>
              <p class="text-xs text-emerald-800 leading-relaxed">
                {rule.description}
              </p>
            </div>
          </div>
        </section>
      )}

      <!-- 5. Full INCI Ingredient Table (§5 requirement) -->
      <section class="mb-10">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-serif text-xl font-semibold text-slate-900">
            Complete INCI formulation ({evaluation.totalIngredients} ingredients)
          </h3>
          <span class="text-xs text-slate-500 font-mono">Deduplicated</span>
        </div>

        <div class="border border-slate-200 rounded-lg overflow-hidden">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-[#fbfbf9] border-b border-slate-200 font-semibold text-slate-700">
                <th class="py-2.5 px-3">#</th>
                <th class="py-2.5 px-3">Ingredient</th>
                <th class="py-2.5 px-3">Status for {rule.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {product.ingredients_list.map((ing: string, i: number) => {
                const flag = evaluation.flagged.find((f: any) => f.ingredient.toLowerCase() === ing.toLowerCase());
                return (
                  <tr class={flag ? 'bg-amber-50/40' : 'bg-white'}>
                    <td class="py-2 px-3 text-slate-400 font-mono">{i + 1}</td>
                    <td class="py-2 px-3 font-medium text-slate-900">{ing}</td>
                    <td class="py-2 px-3">
                      {flag ? (
                        <span class="font-bold text-rose-700 uppercase text-[10px]">
                          Flagged ({flag.severity})
                        </span>
                      ) : (
                        <span class="text-slate-400">Pass</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 6. Evaluated-Only Safe Alternatives (§3 & §5) -->
      {alternatives.length > 0 && (
        <section class="mb-10 p-5 rounded-lg border border-slate-200 bg-[#fbfbf9]">
          <h3 class="font-serif text-lg font-semibold text-slate-900 mb-1">
            Evaluated alternative {product.category} options (10/10 Score)
          </h3>
          <p class="text-xs text-slate-600 mb-4">
            The following formulations in this category have been individually evaluated and contain zero {rule.name} flags:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {alternatives.map((alt: any) => (
              alt.isDripped ? (
                <a
                  href={`/check/${alt.altSlug}`}
                  class="p-3 bg-white rounded border border-slate-200 hover:border-emerald-700 transition-colors block text-xs"
                >
                  <span class="font-semibold text-slate-900 block truncate">{alt.brand}</span>
                  <span class="text-slate-600 block truncate">{alt.name}</span>
                  <span class="text-[10px] text-emerald-800 font-bold block mt-1">Score: 10/10 &middot; 0 Flags</span>
                </a>
              ) : (
                <div class="p-3 bg-white rounded border border-slate-200 block text-xs">
                  <span class="font-semibold text-slate-900 block truncate">{alt.brand}</span>
                  <span class="text-slate-600 block truncate">{alt.name}</span>
                  <span class="text-[10px] text-emerald-800 font-bold block mt-1">Score: 10/10 &middot; 0 Flags</span>
                </div>
              )
            ))}
          </div>
        </section>
      )}

      <!-- 7. Other Checks for this Same Product -->
      {otherChecks.length > 0 && (
        <section class="mb-10">
          <h3 class="font-serif text-lg font-semibold text-slate-900 mb-3">
            Other safety checks for {product.name}
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            {otherChecks.map((oc: any) => (
              oc.isDripped ? (
                <a
                  href={`/check/${oc.slug}`}
                  class="p-2.5 rounded border border-slate-200 hover:border-slate-400 text-xs block bg-white transition-colors"
                >
                  <span class="font-medium text-slate-800 block truncate">{oc.rule.name}</span>
                  <span class="text-[11px] text-slate-500 font-mono mt-0.5 block">{oc.evaluation.score.toFixed(1)}/10</span>
                </a>
              ) : (
                <div class="p-2.5 rounded border border-slate-200 text-xs block bg-white">
                  <span class="font-medium text-slate-800 block truncate">{oc.rule.name}</span>
                  <span class="text-[11px] text-slate-500 font-mono mt-0.5 block">{oc.evaluation.score.toFixed(1)}/10</span>
                </div>
              )
            ))}
          </div>
        </section>
      )}

      <!-- 7b. Visible FAQ Section (§3.3 single source of truth) -->
      {faqItems.length > 0 && (
        <section class="mb-10">
          <h3 class="font-serif text-lg font-semibold text-slate-900 mb-3">
            Frequently Asked Questions
          </h3>
          <div class="space-y-3">
            {faqItems.map((item: any) => (
              <div class="p-4 rounded-lg border border-slate-200 bg-white">
                <h4 class="text-xs font-semibold text-slate-900 mb-1">{item.question}</h4>
                <p class="text-xs text-slate-600 leading-relaxed">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 8. Provenance & Reviewer Box -->
      <section class="p-4 rounded-lg border border-slate-200 bg-white text-xs text-slate-600 leading-relaxed">
        <strong>Source:</strong> {product.source} (<code>{product.barcode}</code>, <a href={product.source_url} target="_blank" rel="noopener noreferrer" class="text-emerald-800 underline">verify</a>) &middot;
        <strong>Verified:</strong> {product.verified_date} &middot;
        <strong>Reviewer:</strong> {SITE_CONFIG.reviewerName} &middot;
        <a href="/contact" class="text-emerald-800 underline">Report error (72h SLA)</a>
      </section>
    </article>
  )}
</Layout>
