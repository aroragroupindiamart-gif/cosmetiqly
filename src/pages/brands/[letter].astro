---
import Layout from '../../layouts/Layout.astro';
import { getBrandsByLetter } from '../../lib/db_v2.js';
import { getCurrentDripDay, isUrlDripped } from '../../lib/drip.js';

const db = Astro.locals?.runtime?.env?.DB;
const currentDay = getCurrentDripDay(Astro.locals?.runtime?.env);
const { letter = 'a' } = Astro.params;
const cleanLetter = (letter || 'a').toUpperCase();
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

const allBrands = await getBrandsByLetter(cleanLetter, db);
const brands = allBrands.filter((b: any) => isUrlDripped(`/brand/${b.brand_slug}`, currentDay));
---

<Layout
  title={`Brands Starting with ${cleanLetter} — Cosmetiqly`}
  description={`Browse cosmetic and skincare brands starting with letter ${cleanLetter}. Verified INCI ingredient reviews.`}
  canonicalPath={`/brands/${cleanLetter.toLowerCase()}`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <a href="/directory" class="hover:text-slate-900">Brand Directory</a>
      <span>/</span>
      <span class="text-slate-700 font-medium">Letter {cleanLetter}</span>
    </nav>

    <header class="mb-8">
      <h1 class="font-serif text-3xl font-semibold text-slate-900">
        Brands Starting with &ldquo;{cleanLetter}&rdquo; ({brands.length})
      </h1>
      <p class="text-sm text-slate-600 mt-1">
        Select a brand to view all verified products and ingredient evaluations.
      </p>
    </header>

    <!-- Alphabet Bar -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 p-3 rounded-lg border border-slate-200 bg-[#fbfbf9] mb-10">
      {alphabet.map(l => (
        <a
          href={`/brands/${l.toLowerCase()}`}
          class={`w-7 h-7 flex items-center justify-center rounded text-xs font-medium transition-colors ${
            l === cleanLetter ? 'bg-emerald-800 text-white' : 'text-slate-700 hover:bg-slate-200'
          }`}
        >
          {l}
        </a>
      ))}
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {brands.map((b: any) => (
        <a
          href={`/brand/${b.brand_slug}`}
          class="p-3 rounded-lg border border-slate-200 hover:border-emerald-700 bg-white block transition-colors"
        >
          <span class="text-xs font-semibold text-slate-900 block truncate">{b.brand}</span>
          <span class="text-[11px] text-slate-500">{b.product_count} products</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
