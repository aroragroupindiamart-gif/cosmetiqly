---
import Layout from '../../layouts/Layout.astro';
import { getBrandsByLetter } from '../../lib/db.js';

const { letter = 'A' } = Astro.params;
const cleanLetter = (letter || 'A').toUpperCase();

const runtimeEnv = Astro.locals?.runtime?.env;
const brands = await getBrandsByLetter(cleanLetter, runtimeEnv);

function slugify(text: string) {
  return text.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<Layout
  title={`Brands Starting with ${cleanLetter} - Cosmetic & Skincare Directory`}
  description={`Browse cosmetic and skincare brands starting with letter ${cleanLetter}. Over 67,000+ formulations analyzed for INCI ingredient safety.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
      <a href="/" class="hover:text-rose-400">Home</a>
      <span>/</span>
      <a href="/directory" class="hover:text-rose-400">Brand Directory</a>
      <span>/</span>
      <span class="text-rose-400 font-semibold">Letter {cleanLetter}</span>
    </nav>

    <!-- Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-semibold text-rose-400 mb-3">
        <span>🔤</span> Letter {cleanLetter} Directory
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-outfit text-white tracking-tight">
        Brands Starting with <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-purple-400">"{cleanLetter}"</span>
      </h1>
      <p class="text-slate-400 text-sm sm:text-base mt-3">
        Showing {brands.length} beauty & skincare brands verified in our dermatological database.
      </p>
    </div>

    <!-- A-Z Alphabet Bar -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 p-4 rounded-2xl bg-slate-900/80 border border-slate-800 mb-12 shadow-xl">
      {alphabet.map((l) => (
        <a
          href={`/brands/${l.toLowerCase()}`}
          class={`w-8 h-8 rounded-lg border flex items-center justify-center text-xs font-bold transition-all ${
            l === cleanLetter
              ? 'bg-rose-500 text-white border-rose-400 shadow-lg shadow-rose-500/30'
              : 'bg-slate-950 border-slate-800 text-slate-300 hover:border-rose-500 hover:text-rose-400'
          }`}
        >
          {l}
        </a>
      ))}
    </div>

    <!-- Brands Grid -->
    {brands.length > 0 ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-16">
        {brands.map((b: any) => (
          <a
            href={`/brand/${slugify(b.brand)}`}
            class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-rose-500/50 hover:bg-slate-900 transition-all text-center group"
          >
            <div class="font-bold text-sm text-white group-hover:text-rose-400 transition-colors line-clamp-1">{b.brand}</div>
            <div class="text-[11px] text-slate-400 mt-1 font-mono">{b.product_count} Formulations</div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-slate-400 text-sm bg-slate-900/40 rounded-2xl border border-slate-800">
        No brands found starting with "{cleanLetter}".
      </div>
    )}

    <!-- Back to Directory -->
    <div class="text-center pt-8 border-t border-slate-800/80">
      <a href="/directory" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white hover:border-rose-500 text-xs font-semibold transition-colors">
        &larr; Return to All Brands Directory
      </a>
    </div>
  </div>
</Layout>
