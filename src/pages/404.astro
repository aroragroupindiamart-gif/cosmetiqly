---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout
  title="404 — Page Not Found | Cosmetiqly"
  description="The page or cosmetic safety check you requested does not exist in our database."
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <span class="text-xs font-mono font-bold px-2 py-1 bg-slate-100 text-slate-600 rounded border border-slate-200">
      HTTP 404
    </span>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-slate-900 mt-4 mb-3">
      Page Not Found
    </h1>
    <p class="text-sm text-slate-600 max-w-md mx-auto mb-8 leading-relaxed">
      The requested formulation check, brand hub, or document does not exist or has been removed from our index.
    </p>
    <div class="flex items-center justify-center gap-3">
      <a href="/" class="text-xs font-semibold px-4 py-2.5 bg-emerald-800 text-white rounded hover:bg-emerald-900 transition-colors">
        Return Home
      </a>
      <a href="/directory" class="text-xs font-semibold px-4 py-2.5 bg-white border border-slate-300 text-slate-700 rounded hover:border-slate-400 transition-colors">
        Browse Brands
      </a>
    </div>
  </div>
</Layout>
