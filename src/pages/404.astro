---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="404 - Page Not Found" description="The page you requested could not be found on Cosmetiqly." noindex={true}>
  <div class="max-w-4xl mx-auto px-4 py-24 text-center">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-3xl font-extrabold mb-6">
      404
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold font-outfit text-white mb-4">
      Page Not Found
    </h1>
    <p class="text-slate-400 max-w-md mx-auto text-base mb-8">
      The cosmetic safety review or page you are looking for does not exist or has been removed.
    </p>
    <div class="flex items-center justify-center gap-4">
      <a href="/" class="px-6 py-3 rounded-xl bg-rose-500 text-white text-sm font-semibold hover:bg-rose-600 transition-colors shadow-lg shadow-rose-500/20">
        Return to Homepage
      </a>
      <a href="/directory" class="px-6 py-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 text-sm font-semibold hover:border-slate-700 transition-colors">
        Browse Brand Directory
      </a>
    </div>
  </div>
</Layout>
