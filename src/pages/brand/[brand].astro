---
import Layout from '../../layouts/Layout.astro';
import { getBrandProducts } from '../../lib/db_v2.js';
import { getCurrentDripDay, getFirstRelevantCheckUrl } from '../../lib/drip.js';

const db = Astro.locals?.runtime?.env?.DB;
const currentDay = getCurrentDripDay(Astro.locals?.runtime?.env);
const { brand = '' } = Astro.params;
const rawProducts = await getBrandProducts(brand, db);
const products = (rawProducts || []).map((p: any) => ({
  ...p,
  checkUrl: getFirstRelevantCheckUrl(p, currentDay)
}));

if (!products || products.length === 0) {
  Astro.response.status = 404;
}

const isFound = products && products.length > 0;
const brandName = isFound ? products[0].brand : brand;
---

<Layout
  title={isFound ? `${brandName} Formulations & INCI Safety Reviews` : "Brand Not Found — Cosmetiqly"}
  description={isFound ? `Explore all verified formulations from ${brandName}. Evaluated against 15 dermatological safety rules.` : "The requested brand was not found."}
  canonicalPath={isFound ? `/brand/${brand}` : undefined}
  noindex={!isFound}
>
  {!isFound ? (
    <div class="max-w-3xl mx-auto px-4 py-20 text-center">
      <span class="text-xs font-mono font-bold px-2 py-1 bg-slate-100 text-slate-600 rounded border border-slate-200">
        404 NOT FOUND
      </span>
      <h1 class="font-serif text-3xl font-semibold text-slate-900 mt-4 mb-3">
        Brand Not Found
      </h1>
      <p class="text-sm text-slate-600 max-w-md mx-auto mb-8">
        We have no verified formulations in our database for this brand slug.
      </p>
      <a href="/directory" class="text-xs font-semibold px-4 py-2 bg-emerald-800 text-white rounded hover:bg-emerald-900">
        Return to Directory
      </a>
    </div>
  ) : (
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
        <a href="/" class="hover:text-slate-900">Home</a>
        <span>/</span>
        <a href="/directory" class="hover:text-slate-900">Brand Directory</a>
        <span>/</span>
        <span class="text-slate-700 font-medium">{brandName}</span>
      </nav>

      <header class="mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">
          Brand Hub
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl text-slate-900 font-semibold tracking-tight">
          {brandName} Ingredient Reviews
        </h1>
        <p class="text-sm text-slate-600 mt-1">
          Showing {products.length} verified products from {brandName}.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {products.map((p: any) => (
          <div class="p-4 rounded-lg border border-slate-200 bg-white flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block mb-1">
                {p.category} &middot; {p.ingredient_count} Ingredients
              </span>
              <h3 class="font-serif text-base font-semibold text-slate-900 mb-2">
                {p.name}
              </h3>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              {p.checkUrl ? (
                <a
                  href={p.checkUrl}
                  class="text-emerald-800 font-semibold hover:underline"
                >
                  View Safety Review &rarr;
                </a>
              ) : (
                <span class="text-slate-400 font-medium">Review scheduled</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}
</Layout>
