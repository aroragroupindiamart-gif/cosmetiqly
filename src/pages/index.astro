---
import Layout from '../layouts/Layout.astro';
import { SAFETY_RULES } from '../lib/safety_rules_v2.js';
import { getTopBrands } from '../lib/db_v2.js';

const topBrands = await getTopBrands(18);

// Curated sample checks for the homepage grid (real products, real evaluations)
const featuredChecks = [
  {
    brand: 'CeraVe',
    name: 'Moisturizing Cream',
    rule: 'Fungal Acne (Malassezia)',
    slug: 'is-cerave-moisturizing-cream-fungal-acne-safe',
    score: 8.5,
    flagged: '1 of 22 flagged',
    tierLabel: 'Review the flags',
    tierColor: 'bg-amber-50 text-amber-800 border-amber-200'
  },
  {
    brand: 'CeraVe',
    name: 'Foaming Facial Cleanser',
    rule: 'Sulfate-Free',
    slug: 'is-cerave-cerave-foaming-facial-cleanser-sulfate-free-safe',
    score: 10.0,
    flagged: '0 of 20 flagged',
    tierLabel: 'No concerns flagged',
    tierColor: 'bg-emerald-50 text-emerald-800 border-emerald-200'
  },
  {
    brand: 'The Ordinary',
    name: 'Granactive Retinoid 2% Emulsion',
    rule: 'Pregnancy & Lactation',
    slug: 'is-the-ordinary-granactive-retinoid-2-emulsion-pregnancy-safe',
    score: 7.0,
    flagged: '1 of 30 flagged',
    tierLabel: 'Review the flags',
    tierColor: 'bg-amber-50 text-amber-800 border-amber-200'
  },
  {
    brand: 'La Roche-Posay',
    name: 'Toleriane Hydrating Gentle Cleanser',
    rule: 'Fragrance-Free',
    slug: 'is-la-roche-posay-toleriane-hydrating-gentle-face-cleanser-fragrance-free-safe',
    score: 10.0,
    flagged: '0 of 15 flagged',
    tierLabel: 'No concerns flagged',
    tierColor: 'bg-emerald-50 text-emerald-800 border-emerald-200'
  },
  {
    brand: 'Neutrogena',
    name: 'Oil Free Acne Face Scrub',
    rule: 'Rosacea & Eczema-Safe',
    slug: 'is-neutrogena-neutrogena-oil-free-acne-face-scrub-125ml-rosacea-eczema-safe',
    score: 4.0,
    flagged: '2 of 30 flagged',
    tierLabel: 'High concern',
    tierColor: 'bg-rose-50 text-rose-800 border-rose-200'
  },
  {
    brand: 'Eucerin',
    name: 'Aquaphor Healing Ointment',
    rule: 'Fragrance-Free',
    slug: 'is-eucerin-aquaphor-healing-ointment-fragrance-free-fragrance-free-safe',
    score: 10.0,
    flagged: '0 of 7 flagged',
    tierLabel: 'No concerns flagged',
    tierColor: 'bg-emerald-50 text-emerald-800 border-emerald-200'
  }
];
---

<Layout 
  title="Cosmetiqly — Cosmetic Ingredient Safety, Scored & Sourced"
  description="What is in your skincare, scored and sourced — not marketed. Independent, cited INCI ingredient evaluations across 15 medical & safety standards."
  canonicalPath="/"
>
  <!-- 1. Hero Section -->
  <section class="border-b border-slate-200 py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold mb-6 border border-slate-200">
        <span>Scientific INCI Database</span> &middot; <span>Zero Invented Data</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl text-slate-900 font-semibold tracking-tight leading-tight mb-6">
        What&rsquo;s in your skincare, <em class="italic font-normal">scored and sourced</em> &mdash; not marketed.
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Transparent, evidence-based ingredient evaluations. Every flagged substance cited against CIR, SCCS, and published dermatological literature.
      </p>

      <!-- Search Box (Pure GET search without broken external dependencies) -->
      <div id="search" class="max-w-xl mx-auto relative">
        <form action="/directory" method="GET" class="relative flex items-center">
          <input
            type="text"
            name="q"
            placeholder="Search real formulations (e.g. CeraVe, The Ordinary, Toleriane)..."
            class="w-full bg-white border border-slate-300 focus:border-emerald-700 rounded-lg py-3.5 pl-11 pr-24 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-emerald-700 shadow-sm"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button type="submit" class="absolute right-2 px-3.5 py-1.5 rounded-md bg-emerald-800 text-white text-xs font-semibold hover:bg-emerald-900 transition-colors">
            Search
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- 2. "How the Score Works" Section (§5 requirement) -->
  <section class="py-16 border-b border-slate-200 bg-[#fbfbf9]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Transparent Methodology</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-slate-900 font-semibold mt-1">How the 1&ndash;10 score works</h2>
        <p class="text-sm text-slate-600 mt-2 leading-relaxed">
          Our scoring uses one public, deterministic formula. We do not invent percentages or sell score improvements to brands.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-lg bg-white border border-slate-200">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200">10.0 / 10</span>
            <span class="text-xs text-slate-500 font-medium">Clean Record</span>
          </div>
          <h3 class="font-serif text-lg font-semibold text-slate-900 mb-2">No concerns flagged</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Formulation contains zero ingredients flagged on the rule blacklist. Fully compliant with specific safety standard.
          </p>
        </div>

        <div class="p-6 rounded-lg bg-white border border-slate-200">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200">7.0 &ndash; 8.5 / 10</span>
            <span class="text-xs text-slate-500 font-medium">Watchlist</span>
          </div>
          <h3 class="font-serif text-lg font-semibold text-slate-900 mb-2">Review the flags</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Contains moderate watchlist items (e.g. concentration-dependent cofactors or mild irritants). Review individual citations before use.
          </p>
        </div>

        <div class="p-6 rounded-lg bg-white border border-slate-200">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold px-2 py-0.5 rounded bg-rose-50 text-rose-800 border border-rose-200">1.0 &ndash; 5.5 / 10</span>
            <span class="text-xs text-slate-500 font-medium">High Risk</span>
          </div>
          <h3 class="font-serif text-lg font-semibold text-slate-900 mb-2">High concern</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Contains one or more high-risk blacklisted substances directly violating the clinical safety standard (e.g., direct yeast feeds or teratogens).
          </p>
        </div>
      </div>

      <div class="mt-8 p-4 rounded-lg border border-slate-200 bg-white text-xs text-slate-600 leading-relaxed">
        <strong>The Math:</strong> <code>Score = max(1, 10 - 3H - 1.5M)</code>, where <em>H</em> is count of high-risk triggers and <em>M</em> is count of moderate watchlist triggers. Limitation: this formula measures presence of flagged compounds, not concentration percentage.
      </div>
    </div>
  </section>

  <!-- 3. Score-Led Product Checks Grid -->
  <section class="py-16 border-b border-slate-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Evaluated Formulations</span>
          <h2 class="font-serif text-2xl sm:text-3xl text-slate-900 font-semibold mt-1">Recently checked products</h2>
          <p class="text-sm text-slate-600 mt-1">Real products evaluated against specific dermatological safety rules.</p>
        </div>
        <a href="/directory" class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 inline-flex items-center gap-1">
          Browse all brands &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredChecks.map(item => (
          <a href={`/check/${item.slug}`} class="group p-5 rounded-lg border border-slate-200 hover:border-slate-400 bg-white hover:shadow-sm transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs mb-2">
                <span class="font-semibold text-slate-900">{item.brand}</span>
                <span class={`font-bold px-2 py-0.5 rounded border text-[11px] ${item.tierColor}`}>
                  {item.tierLabel}
                </span>
              </div>
              <h3 class="font-serif text-lg font-semibold text-slate-900 group-hover:text-emerald-800 transition-colors line-clamp-2 mb-2">
                {item.name}
              </h3>
              <p class="text-xs text-slate-500 font-medium">
                Rule: <span class="text-slate-800">{item.rule}</span>
              </p>
            </div>

            <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-600">{item.flagged}</span>
              <span class="font-semibold text-slate-900">Score: {item.score.toFixed(1)}/10 &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Check By Concern (The 15 Rules Hub) -->
  <section class="py-16 border-b border-slate-200 bg-[#fbfbf9]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Dermatological Criteria</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-slate-900 font-semibold mt-1">Check by skin concern</h2>
        <p class="text-sm text-slate-600 mt-1">Explore our 15 cited rule frameworks.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {SAFETY_RULES.map(rule => (
          <div class="p-4 rounded-lg bg-white border border-slate-200">
            <h3 class="font-serif text-base font-semibold text-slate-900 mb-1">
              {rule.name}
            </h3>
            <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
              {rule.description}
            </p>
            <div class="mt-3 text-[11px] text-slate-400">
              Type: <strong class="text-slate-600 capitalize">{rule.type}</strong> &middot; {rule.triggers.length} cited triggers
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Top Verified Brands -->
  <section class="py-16 border-b border-slate-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Verified Catalog</span>
          <h2 class="font-serif text-2xl sm:text-3xl text-slate-900 font-semibold mt-1">Verified Brand Directory</h2>
        </div>
        <a href="/directory" class="text-xs font-semibold text-emerald-800 hover:text-emerald-950">
          View all 4,700+ brands &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        {topBrands.map((b: any) => (
          <a href={`/brand/${b.brand_slug}`} class="p-3 rounded-lg border border-slate-200 hover:border-emerald-700 bg-white text-center transition-colors">
            <span class="font-medium text-xs text-slate-900 block truncate">{b.brand}</span>
            <span class="text-[10px] text-slate-500">{b.product_count} products</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
